# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example          # keep the example template committed

# ── Next.js build output ──────────────────────────────────────────────────────
.next/
out/

# ── TypeScript incremental build cache ────────────────────────────────────────
# Generated by `tsc --incremental` / `next build`. Contains a serialised
# dependency graph used to speed up subsequent builds. Must never be committed
# — it is machine-specific, large (~100 KB+), and regenerated on every build.
tsconfig.tsbuildinfo

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── OS & editor artefacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Production archive (generated by `npm run archive`) ───────────────────────
faulter.zip

# ── Terraform (infra/cloudflare — see infra/cloudflare/README.md) ─────────────
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.auto.tfvars
!**/*.tfvars.example
crash.log
crash.*.log
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — like
# package-lock.json, it should be committed so everyone applies the same
# pinned provider version.
